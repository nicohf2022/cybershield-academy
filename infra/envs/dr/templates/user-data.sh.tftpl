#!/bin/bash
set -euo pipefail
# Never enable shell tracing: the database password is generated on this host.
umask 077

dnf install -y docker openssl python3 awscli-2 gzip amazon-cloudwatch-agent
systemctl enable --now docker

# Pinned Compose plugin, installed using Docker's documented manual method.
compose_version=v5.6.0
plugin_dir=/usr/local/lib/docker/cli-plugins
install -d -m 0755 "$plugin_dir"
curl --fail --location --retry 5 \
  "https://github.com/docker/compose/releases/download/$compose_version/docker-compose-linux-x86_64" \
  -o "$plugin_dir/docker-compose-linux-x86_64"
curl --fail --location --retry 5 \
  "https://github.com/docker/compose/releases/download/$compose_version/docker-compose-linux-x86_64.sha256" \
  -o /tmp/cybershield-compose.sha256
(cd "$plugin_dir" && sha256sum --check /tmp/cybershield-compose.sha256)
mv "$plugin_dir/docker-compose-linux-x86_64" "$plugin_dir/docker-compose"
chmod 0755 "$plugin_dir/docker-compose"
docker compose version

# Amazon Linux's Docker package does not include the build plugin Compose needs.
buildx_version=v0.39.1
curl --fail --location --retry 5 \
  "https://github.com/docker/buildx/releases/download/$buildx_version/buildx-$buildx_version.linux-amd64" \
  -o "$plugin_dir/buildx-$buildx_version.linux-amd64"
curl --fail --location --retry 5 \
  "https://github.com/docker/buildx/releases/download/$buildx_version/checksums.txt" \
  -o /tmp/cybershield-buildx.sha256
(cd "$plugin_dir" && sha256sum --check --ignore-missing /tmp/cybershield-buildx.sha256)
mv "$plugin_dir/buildx-$buildx_version.linux-amd64" "$plugin_dir/docker-buildx"
chmod 0755 "$plugin_dir/docker-buildx"
docker buildx version

install -d -m 0700 /opt/cybershield
%{ for filename, contents in app_files ~}
install -d -m 0700 "/opt/cybershield/$(dirname '${filename}')"
printf '%s' '${contents}' | base64 --decode | gzip --decompress > '/opt/cybershield/${filename}'
# These are committed source files; PostgreSQL must read the bind-mounted init.sql.
chmod 0644 '/opt/cybershield/${filename}'
%{ endfor ~}

# Build context must not include the runtime secret.
printf '.env\n.backups/\n.database-*.lock\n*.dump\n' > /opt/cybershield/.dockerignore
if [ ! -f /opt/cybershield/.env ]; then
  password=$(openssl rand -hex 32)
  printf 'APP_PORT=80\nPOSTGRES_DB=cybershield\nPOSTGRES_USER=cybershield_app\nPOSTGRES_PASSWORD=%s\n' \
    "$password" > /opt/cybershield/.env
  unset password
fi
chmod 0600 /opt/cybershield/.env

cat > /etc/systemd/system/cybershield.service <<'UNIT'
[Unit]
Description=CyberShield application and PostgreSQL
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecCondition=/usr/bin/test ! -f /opt/cybershield/.writer-fenced
RemainAfterExit=yes
WorkingDirectory=/opt/cybershield
ExecStart=/usr/bin/docker compose --project-name cybershield up --detach --build --wait --wait-timeout 180
ExecStartPost=/usr/bin/curl --fail --retry 30 --retry-delay 2 --retry-all-errors --max-time 5 --retry-max-time 120 http://127.0.0.1/health
ExecStop=/usr/bin/docker compose --project-name cybershield stop
TimeoutStartSec=1200
TimeoutStopSec=120
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT

# Wait for the independent monitoring module to finish creating the log group.
for attempt in $(seq 1 60); do
  if aws logs describe-log-streams --region '${aws_region}' --log-group-name '${log_group_name}' --limit 1 >/dev/null 2>&1; then
    break
  fi
  if [ "$attempt" -eq 60 ]; then echo 'Log group unavailable' >&2; exit 1; fi
  sleep 2
done
instance_id=$(cat /var/lib/cloud/data/instance-id)
cat > /opt/cybershield/compose.override.yaml <<COMPOSE
services:
  app:
    logging:
      driver: awslogs
      options:
        awslogs-region: '${aws_region}'
        awslogs-group: '${log_group_name}'
        awslogs-stream: "$instance_id/app"
        mode: non-blocking
        max-buffer-size: 4m
  db:
    logging:
      driver: awslogs
      options:
        awslogs-region: '${aws_region}'
        awslogs-group: '${log_group_name}'
        awslogs-stream: "$instance_id/db"
        mode: non-blocking
        max-buffer-size: 4m
COMPOSE

cat > /opt/aws/amazon-cloudwatch-agent/etc/cybershield.json <<'AGENT'
{"agent":{"region":"${aws_region}"},"logs":{"logs_collected":{"files":{"collect_list":[{"file_path":"/var/log/cybershield-backup.log","log_group_name":"${log_group_name}","log_stream_name":"{instance_id}/backup"},{"file_path":"/var/log/cybershield-restore.log","log_group_name":"${log_group_name}","log_stream_name":"{instance_id}/restore"}]}}}}
AGENT
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/cybershield.json
cat > /etc/logrotate.d/cybershield <<'ROTATE'
/var/log/cybershield-backup.log /var/log/cybershield-restore.log {
  daily
  rotate 7
  size 10M
  compress
  missingok
  notifempty
  copytruncate
}
ROTATE

systemctl daemon-reload
if [ '${restore_manifest_uri}' != 'none' ] && [ ! -f /opt/cybershield/.restore-complete ]; then
  cd /opt/cybershield
  docker compose --project-name cybershield up --detach --wait --wait-timeout 180 db
  python3 scripts/database.py --project cybershield restore --manifest '${restore_manifest_uri}' --replace > /var/log/cybershield-restore.log 2>&1
  printf '%s\n' '${restore_manifest_uri}' > /opt/cybershield/.restore-complete
fi
systemctl daemon-reload
systemctl enable --now cybershield.service

install -m 0644 /opt/cybershield/systemd/cybershield-backup.service /etc/systemd/system/
install -m 0644 /opt/cybershield/systemd/cybershield-backup.timer /etc/systemd/system/
printf 'BACKUP_S3_PREFIX=${backup_s3_prefix}\n' > /etc/cybershield-backup.env
chmod 0600 /etc/cybershield-backup.env
systemctl daemon-reload
# Establish an initial backup before scheduling hourly ones.
systemctl start cybershield-backup.service
systemctl enable --now cybershield-backup.timer
