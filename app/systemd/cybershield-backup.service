[Unit]
Description=CyberShield PostgreSQL backup to S3
Requires=docker.service
After=docker.service network-online.target cybershield.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/cybershield-backup.env
ExecStart=/usr/bin/python3 /opt/cybershield/scripts/database.py --app-dir /opt/cybershield --project cybershield backup --s3-prefix ${BACKUP_S3_PREFIX}
TimeoutStartSec=45min
